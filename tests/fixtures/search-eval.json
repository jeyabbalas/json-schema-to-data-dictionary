    { "q": "exercise", "expect": ["pa_mets", "pa_pct"], "tags": ["semantic"] },
    { "q": "MET hours", "expect": ["pa_mets"], "tags": ["or-fallback"] },
    { "q": "height", "expect": ["height"], "tags": ["exact"] },
    { "q": "waist to hip ratio", "expect": ["whr"], "tags": ["lexical", "multi"] },
    { "q": "WHR", "expect": ["whr"], "tags": ["exact", "abbr"] },
