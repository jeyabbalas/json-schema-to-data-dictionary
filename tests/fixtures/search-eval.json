    { "q": "7777", "expect": ["BBD_year1", "BBD_year2", "BBD_year3", "BBD_year4", "lastscreen_year"], "tags": ["code"] },
    { "q": "mammogram", "expect": ["screen_ever", "screen_start", "lastscreen_year"], "tags": ["lexical"] },
    { "q": "breast cancer screening", "expect": ["screen_ever", "screen_start", "lastscreen_year"], "tags": ["semantic", "multi"] },
    { "q": "family history", "expect": ["fhx_fdr_brca", "FHisFstBC", "FHisFstBCNr", "FHisFstOC"], "tags": ["lexical", "category", "multi"] },
