{
  "$comment": "Labelled search queries over tests/fixtures/multiple_schema_2 (BCRPP). `expect` lists variable names that should rank in the top results. Tags: lexical (words present in name/description), semantic (needs an embedding model), abbr (abbreviation), code (a sentinel code), multi (multi-word), prefix (as-you-type prefix), stem (plural/singular), or-fallback (no row has every word), exact (whole variable name), values (enum label), substring (punctuation), category (category title), typo (misspelling; informational only).",
  "queries": [
    { "q": "smoking", "expect": ["smoking_status", "smoking_init", "smoking_amt", "smoking_dur", "smoking_stop"], "tags": ["lexical", "prefix"] },
    { "q": "tobacco", "expect": ["smoking_status", "smoking_init", "smoking_amt", "smoking_dur", "smoking_stop"], "tags": ["semantic", "category"] },
    { "q": "cigarette", "expect": ["smoking_status", "smoking_amt", "smoking_init"], "tags": ["semantic"] },
    { "q": "cigarettes per day", "expect": ["smoking_amt"], "tags": ["semantic"] },
    { "q": "drinking habits", "expect": ["alcohol_status", "alcohol_amt"], "tags": ["semantic"] },
    { "q": "alcohol", "expect": ["alcohol_status", "alcohol_init", "alcohol_amt", "alcohol_stop", "alcohol_dur"], "tags": ["lexical", "prefix"] },
    { "q": "BMI", "expect": ["bmi", "bmi_earlyadult"], "tags": ["abbr", "exact"] },
    { "q": "body mass index", "expect": ["bmi", "bmi_earlyadult"], "tags": ["lexical", "multi"] },
    { "q": "body size", "expect": ["bmi", "height", "weight", "waist", "hip"], "tags": ["semantic"] },
    { "q": "HRT", "expect": ["hrtuse", "hrt_dur", "hrtuse_ep", "hrtep_dur", "hrtuse_eonly", "hrteonly_dur"], "tags": ["abbr", "prefix"] },
    { "q": "hormone replacement therapy", "expect": ["hrtuse", "hrt_dur", "hrtuse_ep", "hrtep_dur", "hrtuse_eonly", "hrteonly_dur"], "tags": ["lexical", "multi"] },
    { "q": "OC", "expect": ["ocuse_ever", "ocuse_current", "ocuse_dur", "ocuse_start", "ocuse_stop"], "tags": ["abbr", "prefix"] },
    { "q": "oral contraceptives", "expect": ["ocuse_ever", "ocuse_current", "ocuse_dur", "ocuse_start", "ocuse_stop"], "tags": ["lexical", "stem", "multi"] },
    { "q": "birth control", "expect": ["ocuse_ever", "ocuse_current", "othcontracep_ever", "othcontracep_current"], "tags": ["semantic"] },
    { "q": "age at first birth", "expect": ["age_preg1"], "tags": ["multi", "semantic"] },
    { "q": "menopause", "expect": ["meno_status", "meno_age", "meno_reason"], "tags": ["lexical"] },
