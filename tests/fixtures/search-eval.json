    { "q": "breastfeeding duration", "expect": ["breastfeed_dur", "breastfeed_dur_b1", "breastfeed_dur_b2", "breastfeed_dur_b3"], "tags": ["lexical", "multi"] },
    { "q": "meno_age", "expect": ["meno_age"], "tags": ["exact"] },
    { "q": "age preg", "expect": ["age_preg1", "age_preg2", "age_preg3"], "tags": ["prefix"] },
    { "q": "smoking age", "expect": ["smoking_init", "smoking_stop"], "tags": ["multi", "lexical"] },
    { "q": "parity", "expect": ["parity", "parous"], "tags": ["exact", "semantic"] },
    { "q": "number of children", "expect": ["parity", "daughters"], "tags": ["semantic"] },
    { "q": "kg/m2", "expect": ["bmi", "bmi_earlyadult"], "tags": ["substring"] },
    { "q": "smokng", "expect": ["smoking_status", "smoking_init", "smoking_amt", "smoking_dur", "smoking_stop"], "tags": ["typo"] }
  ]
}
